FROM python:3.11

# Variáveis de ambiente para controle de comportamento do Python
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Timezone do container (agendamentos do cron e datas geradas pela aplicação)
ENV TZ=America/Sao_Paulo

# Evita que o apt-get pare o build esperando prompt interativo (ex: tzdata)
ENV DEBIAN_FRONTEND=noninteractive

# Copia os arquivos necessários para o contêiner
COPY api /api
COPY api/scripts /scripts

# Define o diretório de trabalho
WORKDIR /api/system

# Instala dependências, timezone, cron e dos2unix
RUN apt-get update && \
    apt-get install -y netcat-openbsd postgresql-client dos2unix cron tzdata && \
    ln -snf "/usr/share/zoneinfo/$TZ" /etc/localtime && echo "$TZ" > /etc/timezone && \
    rm -rf /var/lib/apt/lists/* && \
    find /scripts -type f -exec dos2unix {} +

RUN python -m venv /venv && \
  /venv/bin/pip install --upgrade pip && \
  /venv/bin/pip install -r /api/system/requirements.txt && \
  mkdir -p /data/web/static && \
  mkdir -p /data/web/media && \
  chmod -R 755 /data/web/static && \
  chmod -R 755 /data/web/media && \
  chmod -R +x /scripts


# Instala os agendamentos definidos em /scripts/cron/crontab
RUN crontab /scripts/cron/crontab

ENV PATH="/scripts:/venv/bin:$PATH"

# Exponha a porta 8000 para a aplicação Django
EXPOSE 8000

CMD ["sh", "-c", "commands.sh"]
