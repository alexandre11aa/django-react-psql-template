server {

    listen 80;
    server_name ${SERVER_NAME};
    set $is_debug ${DEBUG};

    # Django: Admin
    location ^~ /admin/ {
        if ($is_debug = 0) {
            return 302 /;
        }

        proxy_pass http://system-api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Django: API
    location /api/ {
        proxy_pass http://system-api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 150M;
    }

    # Django: STATIC
    location ^~ /static/ {
        alias /data/web/static/;
        try_files $uri =404;
    }

    # Django: MEDIA
    location ^~ /media/ {
        alias /data/web/media/;
        try_files $uri =404;
    }

    # React: ROOT
    root /usr/share/nginx/html;
    index index.html;

    # React: Routes (SPA fallback)
    location / {
        try_files $uri /index.html;
    }

}
